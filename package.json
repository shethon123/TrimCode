{
  "name": "trim-code",
  "version": "1.0.0",
  "description": "Injector barcode scanner desktop utility",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "build:linux": "electron-vite build && electron-builder --linux --x64",
    "preview": "electron-vite preview",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.trimcode.injectorscanner",
    "productName": "Trim Code",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.ico",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
